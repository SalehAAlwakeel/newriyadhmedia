# Copy to .env.local and fill in real values. NEVER commit .env.local.

# OpenAI — powers AI text + image generation. Server-side only.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL_SMART=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini
# Optional: image model (defaults to gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1

# Session signing secret (HMAC). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Database (Prisma). SQLite for local dev; swap for a Postgres URL in prod.
DATABASE_URL="file:./dev.db"
