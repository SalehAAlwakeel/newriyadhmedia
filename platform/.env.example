# Copy to .env.local and fill in real values. NEVER commit .env.local.

# OpenAI — text (captions, strategy) + image generation (GPT Image 2)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL_SMART=gpt-4.1
OPENAI_MODEL_MINI=gpt-4.1-mini
# Hidden prompt rewriter (image/video generation) — defaults to gpt-4.1
OPENAI_MODEL_ENHANCE=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Google Gemini — Short-form Video via Veo 3.1 (direct Google API)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GOOGLE_VEO_MODEL=veo-3.1-generate-preview
GOOGLE_VEO_RESOLUTION=1080p

# Optional: fal.ai only if you set IMAGE_PROVIDER=fal for FLUX images
# FAL_KEY=your-fal-key-here
# IMAGE_PROVIDER=fal
# FAL_IMAGE_MODEL=fal-ai/flux-pro/v1.1-ultra
# FAL_IMAGE_RAW=false

# Session signing secret (HMAC). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Database — local dev uses SQLite (see AGENTS.md). For production Postgres/Supabase,
# switch provider in prisma/schema.prisma and set DATABASE_URL accordingly.
DATABASE_URL="file:./prisma/dev.db"

# Optional: object storage for generated/uploaded media (Supabase Storage)
# SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."

# Secret used to encrypt social OAuth tokens at rest (32+ random bytes).
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY="change-me-base64-32-bytes"

# Moyasar — Saudi payment gateway (mada, Apple Pay, cards in SAR)
# Get keys at https://moyasar.com
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_SECRET_KEY=""

# Cron secret — Vercel cron sends Authorization: Bearer {CRON_SECRET}
CRON_SECRET="change-me-to-a-long-random-string"

# Public app URL — required for Instagram to fetch generated images when publishing.
# Local dev: use an ngrok/cloudflare tunnel URL (Meta cannot reach localhost).
APP_URL="http://localhost:3000"

# Marketing site URL — the static site (repo root) served on its own domain.
# Public topbar links and "talk to an expert" CTAs point here.
NEXT_PUBLIC_MARKETING_URL="http://localhost:8080"

# Meta / Instagram — create an app at https://developers.facebook.com/
# Enable Instagram Graph API + Facebook Login. Add redirect URI:
#   {APP_URL}/api/integrations/callback/instagram
META_CLIENT_ID=""
META_CLIENT_SECRET=""
